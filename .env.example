# Neon Database URL
# Replace with your actual Neon connection string
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# JWT Configuration
# IMPORTANT: Generate a strong random secret for production!
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# JWT Expiration
JWT_EXPIRES_IN=7d

# Demo account — publiek toegankelijk met één gedeeld wachtwoord.
# Zet hier de demo-e-mail en -wachtwoord. Gebruikers die dit wachtwoord
# invullen, krijgen toegang tot de gedeelde demo-account (demo@impactreis.nl).
# Gebruik een sterk wachtwoord in productie.
DEMO_EMAIL=demo@impactreis.nl
DEMO_PASSWORD=demo123

# Server Configuration
PORT=3001
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# API Configuration
API_BASE_URL=http://localhost:3001/api

# De Sparringpartner: brug naar ImpactOS (holding-brede context + proactief signaal)
# Gedeeld geheim — zelfde waarde als COACH_BRIDGE_TOKEN in ImpactOS' .env
IMPACTOS_BASE_URL=http://localhost:1250
COACH_BRIDGE_TOKEN=

# Google Calendar (service-account, alleen-lezen) — zelfde credentials als ImpactOS/agentos
# gebruikt (D:\apps\agentos, backend/domains/calendar/service_google.py). De agenda moet
# expliciet gedeeld zijn met dit service-account-e-mailadres.
GOOGLE_CALENDAR_CLIENT_EMAIL=
GOOGLE_CALENDAR_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=

# /admin — beveiligd admin-panel (blog, CRM, administratie), los van de reguliere gebruikersauth.
# ADMIN_AUTH_SECRET tekent de sessiecookie; valt terug op AUTH_SECRET als niet gezet.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_AUTH_SECRET=

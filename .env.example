# Neon Database URL
# Replace with your actual Neon connection string
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# JWT Configuration
# IMPORTANT: Generate a strong random secret for production!
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# JWT Expiration
JWT_EXPIRES_IN=7d

# Server Configuration
PORT=3001
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# API Configuration
API_BASE_URL=http://localhost:3001/api

# De Sparringpartner: brug naar ImpactOS (holding-brede context + proactief signaal)
# Gedeeld geheim — zelfde waarde als COACH_BRIDGE_TOKEN in ImpactOS' .env
IMPACTOS_BASE_URL=http://localhost:1250
COACH_BRIDGE_TOKEN=

# Google Calendar (service-account, alleen-lezen) — zelfde credentials als ImpactOS/agentos
# gebruikt (D:\apps\agentos, backend/domains/calendar/service_google.py). De agenda moet
# expliciet gedeeld zijn met dit service-account-e-mailadres.
GOOGLE_CALENDAR_CLIENT_EMAIL=
GOOGLE_CALENDAR_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=
